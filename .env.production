ENV_FILE=.env.production
ENVIRONMENT=production
API_PREFIX=/api/v1

APP_NAME=FastAPI Template
APP_VERSION=0.1.0
OPENAPI_URL=/openapi.json
SCALAR_PATH=/scalar
DOCS_ENABLED=false
REQUEST_ID_HEADER=X-Request-ID
CORS_ALLOW_ORIGINS=https://example.invalid
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=
CORS_MAX_AGE=600

SERVER_HOST=0.0.0.0
SERVER_PORT=1114
SERVER_RELOAD=false

LOG_LEVEL=INFO
LOG_DIR=/tmp/fastapi-template-logs
LOG_FILE=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_JSON=true
