# Versioned template values only; DevOps supplies real deployment credentials.
ENV_FILE=.env.dev
ENVIRONMENT=development
API_PREFIX=/api/v1

APP_NAME=FastAPI Template
APP_VERSION=0.1.0
OPENAPI_URL=/openapi.json
SCALAR_PATH=/scalar
DOCS_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=
CORS_MAX_AGE=600

# HTTP stays disabled until a real token and deployment allowlists are supplied.
MCP_ENABLED=false
MCP_BEARER_TOKEN=<replace-with-a-random-token-at-deployment>
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
# Empty means browser origins are not allowed; configure with DevOps if needed.
MCP_ALLOWED_ORIGINS=

SERVER_HOST=0.0.0.0
SERVER_PORT=1114
SERVER_RELOAD=true

LOG_LEVEL=DEBUG
LOG_DIR=/tmp/fastapi-template-logs
LOG_FILE=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_JSON=false
